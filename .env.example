# Local runtime
PORT=8080
DOWNLOAD_DIR=/tmp/videodl
TASK_DB_PATH=/tmp/videodl/tasks.sqlite3

# Resource limits
MAX_DURATION_SECONDS=7200
MAX_FILE_MB=1024
MAX_CONCURRENT_DOWNLOADS=2
TASK_QUEUE_SIZE=8
TASK_RETENTION_SECONDS=3600
MAX_REQUEST_BYTES=16384

# Rate limits
RATE_LIMIT_PER_MINUTE=10
TASK_STATUS_RATE_LIMIT_PER_MINUTE=240
